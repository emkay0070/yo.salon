# API Configuration
NEXT_PUBLIC_API_URL=https://your-backend-domain.com/api/v1

# Mapbox Token
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# Root Domain
NEXT_PUBLIC_ROOT_DOMAIN=yosalon.vercel.app

# Laravel Reverb Configuration (Production)
# Note: Use your domain with SSL, not IP address directly
NEXT_PUBLIC_REVERB_APP_KEY=your-production-reverb-key
NEXT_PUBLIC_REVERB_HOST=api.yourdomain.com
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
