    /* ─────────────────────────────────────────────────────────────────────
     * Journey 13: Customer portal operations
     * ───────────────────────────────────────────────────────────────────── */

    public function test_journey_13_customer_portal_operations(): void
    {
        // Register a customer portal account.
        $register = $this->postJson('/api/v1/auth/register', [
            'name' => 'Portal Customer',
            'email' => 'portalcustomer@example.com',
            'password' => 'password123',
            'journey' => 'customer',
        ]);
        $register->assertStatus(201);
        $portalToken = $register->json('token');

        // Customer portal login.
        $login = $this->postJson('/api/v1/portal/login', [
            'email' => 'portalcustomer@example.com',
            'password' => 'password123',
        ]);
        $login->assertStatus(200);

        // Portal context/me.
        $me = $this->withToken($portalToken, 'portal')
            ->getJson('/api/v1/portal/me');
        $me->assertStatus(200);

        // Portal services listing.
        $services = $this->withToken($portalToken, 'portal')
            ->withHeaders(['X-Provider-Id' => $this->providerA->id])
            ->getJson('/api/v1/portal/services');
        $services->assertStatus(200);

        // Portal availability.
        $availability = $this->withToken($portalToken, 'portal')
            ->withHeaders(['X-Provider-Id' => $this->providerA->id])
            ->getJson('/api/v1/portal/availability', [
                'location_id' => $this->locationA->id,
                'date' => now()->addDays(2)->format('Y-m-d'),
            ]);
        $availability->assertStatus(200);
    }

    /* ─────────────────────────────────────────────────────────────────────
     * Journey 14: Analytics and operational reporting
     * ───────────────────────────────────────────────────────────────────── */

    public function test_journey_14_analytics_and_operational_reporting(): void
    {
        // Provider analytics.
        $analytics = $this->withToken($this->tokenA)
            ->withHeaders(['X-Provider-Id' => $this->providerA->id])
            ->getJson('/api/v1/analytics');
        $analytics->assertStatus(200);

        // Dashboard live stats.
        $dashboard = $this->withToken($this->tokenA)
            ->withHeaders(['X-Provider-Id' => $this->providerA->id])
            ->getJson('/api/v1/dashboard/live-stats');
        $dashboard->assertStatus(200);

        // Operational health for a location.
        $health = $this->withToken($this->tokenA)
            ->withHeaders(['X-Provider-Id' => $this->providerA->id])
            ->getJson("/api/v1/locations/{$this->locationA->id}/health");
        $health->assertStatus(200);

        // Provider health.
        $providerHealth = $this->withToken($this->tokenA)
            ->withHeaders(['X-Provider-Id' => $this->providerA->id])
            ->getJson("/api/v1/providers/{$this->providerA->id}/health");
        $providerHealth->assertStatus(200);
    }

    /* ─────────────────────────────────────────────────────────────────────
     * Cross-domain consistency
     * ───────────────────────────────────────────────────────────────────── */

    public function test_cross_domain_provider_ownership_and_location_validity(): void
    {
        // Every booking created under Provider A carries Provider A's id and a valid location.
        $bookingService = app(CustomerBookingService::class);
        $booking = $bookingService->createBooking([
            'customer_id' => $this->customer->id,
            'location_id' => $this->locationA->id,
            'service_id' => $this->service->id,
            'date' => now()->addDays(5)->format('Y-m-d'),
            'time' => '10:00',
        ]);

        $this->assertEquals($this->providerA->id, $booking->provider_id);
        $this->assertEquals($this->locationA->id, $booking->location_id);
        $this->assertTrue($booking->location->provider_id === $this->providerA->id);

        // Related customer-provider relationship exists.
        $this->assertDatabaseHas('customer_providers', [
            'customer_id' => $this->customer->id,
            'provider_id' => $this->providerA->id,
        ]);
    }

    /* ─────────────────────────────────────────────────────────────────────
     * Tenant isolation
     * ───────────────────────────────────────────────────────────────────── */

    public function test_tenant_isolation_across_providers(): void
    {
        // Provider A's staff are not visible under Provider B's context.
        Staff::factory()->create(['provider_id' => $this->providerA->id]);

        $staffA = $this->withToken($this->tokenA)
            ->withHeaders(['X-Provider-Id' => $this->providerA->id])
            ->getJson("/api/v1/providers/{$this->providerA->id}/staff");
        $staffA->assertStatus(200);

        $staffB = $this->withToken($this->tokenA)
            ->withHeaders(['X-Provider-Id' => $this->providerB->id])
            ->getJson("/api/v1/providers/{$this->providerB->id}/staff");
        $staffB->assertStatus(200);

        // Provider B's token cannot touch Provider A's staff.
        $cross = $this->withToken($this->tokenB)
            ->withHeaders(['X-Provider-Id' => $this->providerA->id])
            ->postJson("/api/v1/providers/{$this->providerA->id}/staff", [
                'name' => 'Intruder',
                'email' => 'intruder@example.com',
                'role' => 'receptionist',
            ]);
        $cross->assertStatus(403);

        // Provider B's bookings are not returned when querying Provider A.
        Booking::factory()->create([
            'provider_id' => $this->providerB->id,
            'location_id' => $this->locationB->id,
        ]);
        $bookingsA = $this->withToken($this->tokenA)
            ->withHeaders(['X-Provider-Id' => $this->providerA->id])
            ->getJson('/api/v1/bookings');
        $bookingsA->assertStatus(200);
        foreach ($bookingsA->json('data') ?? [] as $b) {
            $this->assertEquals($this->providerA->id, $b['provider_id'] ?? null);
        }
    }

    public function test_unauthorized_access_is_rejected(): void
    {
        // No token: protected routes are rejected.
        $this->getJson('/api/v1/me')->assertStatus(401);
        $this->postJson('/api/v1/bookings', [])->assertStatus(401);
        $this->getJson('/api/v1/analytics')->assertStatus(401);

        // Specialist portal without specialist auth is rejected.
        $this->getJson('/api/v1/specialist-portal/context')->assertStatus(401);

        // Customer portal without portal auth is rejected.
        $this->getJson('/api/v1/portal/me')->assertStatus(401);
    }

    /* ─────────────────────────────────────────────────────────────────────
     * Data integrity and failure recovery
     * ───────────────────────────────────────────────────────────────────── */

    public function test_duplicate_booking_submission_is_handled(): void
    {
        // Two rapid bookings for the same slot should not both succeed if the
        // domain enforces conflict checks. At minimum, both must be valid
        // records or a clear conflict error is returned.
        $bookingData = [
            'provider_id' => $this->providerA->id,
            'location_id' => $this->locationA->id,
            'customer_id' => $this->customer->id,
            'service_id' => $this->service->id,
            'date' => now()->addDays(5)->format('Y-m-d'),
            'time' => '10:00',
        ];

        $first = $this->withToken($this->tokenA)
            ->withHeaders(['X-Provider-Id' => $this->providerA->id])
            ->postJson('/api/v1/bookings/with-account', array_merge($bookingData, [
                'customer_name' => 'First',
                'customer_phone' => '+1111111111',
                'customer_email' => 'first@example.com',
            ]));
        $first->assertStatus(201);

        // Second identical booking (may succeed or conflict depending on slot
        // locking) — must not be a 500 server error.
        $second = $this->withToken($this->tokenA)
            ->withHeaders(['X-Provider-Id' => $this->providerA->id])
            ->postJson('/api/v1/bookings/with-account', array_merge($bookingData, [
                'customer_name' => 'Second',
                'customer_phone' => '+2222222222',
                'customer_email' => 'second@example.com',
            ]));
        $this->assertContains($second->status(), [200, 201, 409, 422]);
    }

    public function test_invalid_state_transition_is_rejected(): void
    {
        $booking = Booking::create([
            'location_id' => $this->locationA->id,
            'provider_id' => $this->providerA->id,
            'customer_id' => $this->customer->id,
            'service_id' => $this->service->id,
            'date' => now()->toDateString(),
            'time' => '10:00',
            'status' => 'confirmed',
            'amount_due' => 50000,
            'amount_paid' => 0,
        ]);

        // Attempting to arrive a booking without provider context is rejected.
        $noContext = $this->withToken($this->tokenA)
            ->postJson("/api/v1/bookings/{$booking->id}/arrive");
        $this->assertContains($noContext->status(), [400, 403, 422]);

        // Attempting to complete a confirmed booking without arriving should be
        // rejected by the domain state machine.
        $bookingServiceId = $booking->id;
        $premature = $this->withToken($this->tokenA)
            ->withHeaders(['X-Provider-Id' => $this->providerA->id])
            ->postJson("/api/v1/bookings/{$booking->id}/services/{$bookingServiceId}/complete");
        $this->assertContains($premature->status(), [400, 409, 422]);
    }

    public function test_failed_operation_does_not_leave_partial_records(): void
    {
        $initialBookingCount = Booking::count();

        // A booking with invalid data must not create a partial booking.
        $invalid = $this->withToken($this->tokenA)
            ->withHeaders(['X-Provider-Id' => $this->providerA->id])
            ->postJson('/api/v1/bookings/with-account', [
                'provider_id' => $this->providerA->id,
                // missing required service_id, date, time
            ]);
        $this->assertContains($invalid->status(), [400, 422]);

        $this->assertEquals($initialBookingCount, Booking::count());
    }

    public function test_idempotency_key_is_enforced_on_payment_requests(): void
    {
        $paymentRequest = $this->withToken($this->tokenA)
            ->withHeaders(['X-Provider-Id' => $this->providerA->id])
            ->postJson('/api/v1/payment-requests', [
                'idempotency_key' => 'idem-key-phase4',
                'amount' => 10000,
            ]);
        $this->assertContains($paymentRequest->status(), [200, 201]);

        // Reusing the same idempotency key should not create a duplicate.
        $duplicate = $this->withToken($this->tokenA)
            ->withHeaders(['X-Provider-Id' => $this->providerA->id])
            ->postJson('/api/v1/payment-requests', [
                'idempotency_key' => 'idem-key-phase4',
                'amount' => 10000,
            ]);
        $this->assertContains($duplicate->status(), [200, 409, 422]);
    }

    /**
     * Authenticate as a model under a specific guard using a Sanctum token.
     *
     * @param  string  $token
     * @param  string|null  $guard  'sanctum' | 'portal' | 'specialist'
     * @return $this
     */
    protected function withToken(string $token, ?string $guard = null): self
    {
        if ($guard === 'portal') {
            $this->authenticatePortal($token);
        } elseif ($guard === 'specialist') {
            $this->authenticateSpecialist($token);
        } else {
            $this->authenticateSanctum($token);
        }

        return $this;
    }

    protected function authenticateSanctum(string $token): void
    {
        $this->app->instance('auth', $this->app->make('auth'));
        $user = \App\Models\User::whereHas('tokens', function ($q) use ($token) {
            $q->where('name', 'phase4-a')->orWhere('name', 'phase4-b');
        })->first();

        if ($user) {
            $this->actingAs($user, 'sanctum');
        } else {
            $this->withHeader('Authorization', "Bearer {$token}");
        }
    }

    protected function authenticatePortal(string $token): void
    {
        $account = \App\Models\PortalAccount::whereHas('tokens', function ($q) use ($token) {
            $q->where('name', 'portal-account');
        })->first();
        if ($account) {
            $this->actingAs($account, 'portal');
        } else {
            $this->withHeader('Authorization', "Bearer {$token}");
        }
    }

    protected function authenticateSpecialist(string $token): void
    {
        $account = \App\Models\SpecialistAccount::whereHas('tokens', function ($q) use ($token) {
            $q->where('name', 'specialist-portal');
        })->first();
        if ($account) {
            $this->actingAs($account, 'specialist');
        } else {
            $this->withHeader('Authorization', "Bearer {$token}");
        }
    }
}
